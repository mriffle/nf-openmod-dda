// Config overlay applied by test/run-tests.sh (passed last, so it wins).
//
// The test harness must not depend on a container engine: stub tasks and the
// shell-only modules (VALIDATE_DECOY_OPTIONS, FILTER_PIN_COLUMNS) then run
// directly on the host. Real tool images (Magnum, Percolator, msconvert, ...)
// are exercised separately by the Docker-based smoke tests in CI.
docker.enabled      = false
singularity.enabled = false
podman.enabled      = false
