/**
 * # nf-openmod-dda
 *
 * A Nextflow pipeline for open-modification DDA proteomics built around Magnum.
 */
params {
    /** \group{Input/Output Parameters} */

    /** \type{string} \required
     *  Path to the FASTA file containing the subset of proteins sequences to
     *  search.
     */
    fasta = null

    /** \type{bool}
     *  Whether to generate decoys using YARP (https://github.com/mriffle/yarp)
     *  Required if FASTA does not contain decoys and if Magnum is not generating decoys
     */
    generate_decoys = false

    /** \type{string} \required
     *  The directory containing the mzML or raw files to search
     */
    spectra_dir = null

    /** \type{string}
     *  The path to the Magnum config file
     */
    magnum_conf = 'Magnum.conf'

    /** \type{list}
     *  Optional list of PIN column headers to remove before running Percolator.
     *  Can also be provided as a comma-delimited string.
     */
    percolator_pin_columns_to_remove = []
    process_separately = false
    
    result_dir = 'results/nf-openmod-dda' /** \type{str} Where results will be saved. */
    report_dir = 'reports/nf-openmod-dda' /** \type{str} Where Nextflow execution reports (timeline, report, trace) are written. */
    email = null           /** \type{str} An email to alert on completion. */

    limelight_webapp_url = null
    limelight_project_id = null
    limelight_tags = null
    limelight_search_description = null
    limelight_search_short_name = null
    limelight_upload = false
}

plugins {
    id 'nf-schema@2.3.0'
    id 'nf-amazon'
}

docker {
    enabled = true
}

/*
 * Set up secrets in the environment. 
 * Need to do it this way because Nextflow doesn't allow the use of secrets when running on AWS Batch
 */
env.PLACEHOLDER_KEY = "PLACEHOLDER_VALUE"
env.LIMELIGHT_SUBMIT_UPLOAD_KEY = nextflow.secret.SecretsLoader.instance.load().getSecret("LIMELIGHT_SUBMIT_UPLOAD_KEY")?.value
env.PANORAMA_API_KEY = nextflow.secret.SecretsLoader.instance.load().getSecret("PANORAMA_API_KEY")?.value

aws {

    client {
        maxConnections     = 20
        connectionTimeout  = 10000
        uploadStorageClass = 'INTELLIGENT_TIERING'
        storageEncryption  = 'AES256'
    }

    batch {
        // NOTE: this setting is only required if the AWS CLI tool is installed in a custom AMI
        cliPath   = '/usr/local/aws-cli/v2/current/bin/aws'
        logsGroup = '/batch/tei-nextflow-batch'
        retryMode = 'standard'
    }

    region = 'us-west-2'
}

// Execution Profiles
profiles {

    /*
     * Params for running pipeline on the local computer (e.g.:
     * your laptop). These can be overridden in the local config file.
     */
    standard {
        process.executor = 'local'

        // limit nextflow to running 1 task at a time
        executor.queueSize = 1

        // cap per-task resource requests to what this machine provides
        process.resourceLimits = [ cpus: 8, memory: 12.GB, time: 240.h ]

        // where to cache mzml files after running msconvert
        params.mzml_cache_directory = '/data/mass_spec/nextflow/nf-openmod-dda/mzml_cache'
        params.panorama_cache_directory = '/data/mass_spec/nextflow/panorama/raw_cache'
    }

    aws {
        process.executor = 'awsbatch'
        process.queue = 'nextflow_basic_ec2'

        // params for running pipeline on aws batch
        // These can be overridden in local config file

        // cap per-task resource requests to your AWS Batch compute environment
        process.resourceLimits = [ cpus: 32, memory: 124.GB, time: 240.h ]

        // where to cache mzml files after running msconvert
        params.mzml_cache_directory = 's3://mc-tei-rex-nextflow-dda/openmod/mzml_cache'
        params.panorama_cache_directory = 's3://mc-tei-rex-nextflow-dda/panorama_cache'
    }

    slurm {
        process.executor = 'slurm'

        process.resourceLimits = [ cpus: 8, memory: 12.GB, time: 240.h ]

        // where to cache mzml files after running msconvert
        params.mzml_cache_directory = '/data/mass_spec/nextflow/nf-openmod-dda/mzml_cache'
        params.panorama_cache_directory = '/data/mass_spec/nextflow/panorama/raw_cache'
    }

}

// Manifest
manifest {
    name            = 'nf-openmod-dda'
    author          = 'Michael Riffle'
    homePage        = 'https://github.com/mriffle/nf-openmod-dda'
    description     = 'DDA workflows for TEI-REX project'
    mainScript      = 'main.nf'
    nextflowVersion = '!>=25.10.0'
}

// Capture exit codes from upstream processes when piping
process.shell = ['/bin/bash', '-euo', 'pipefail']

// Execution reports. The strict config language (Nextflow 25.10+/26) does not
// allow computing a per-run timestamp here, so reports use stable names and
// overwrite on each run (report_dir is a transient, gitignored output location).
timeline {
    enabled   = true
    overwrite = true
    file      = "${params.report_dir}/execution_timeline.html"
}
report {
    enabled   = true
    overwrite = true
    file      = "${params.report_dir}/execution_report.html"
}
trace {
    enabled   = true
    overwrite = true
    file      = "${params.report_dir}/execution_trace.txt"
}
dag {
    enabled   = false
    overwrite = true
    file      = "${params.report_dir}/pipeline_dag.html"
}

// Load base.config by default for all pipelines
includeConfig 'conf/base.config'
includeConfig 'container_images.config'
